  <regions type="content">
    <region left="0" top="0" width="74" height="24" color="#000000" bgColor="#00ff00" fontSize="10">
      <math decimalPlaces="3" significantDigitsMode="true" exponentialThreshold="6">
        <input>
          <e type="operand">F</e>
          <e type="operand">3</e>
          <e type="operand" style="unit">MHz</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="0" top="18" width="128" height="41" color="#000000" fontSize="10">
      <math decimalPlaces="3" significantDigitsMode="true" exponentialThreshold="6">
        <input>
          <e type="operand">T</e>
          <e type="operand">1</e>
          <e type="operand">F</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">μs</e>
        </contract>
        <result action="numeric">
          <e type="operand">0.333</e>
        </result>
      </math>
    </region>
    <region left="0" top="54" width="152" height="30" color="#000000" fontSize="10">
