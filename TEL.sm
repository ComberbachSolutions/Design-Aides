        </result>
      </math>
    </region>
    <region left="162" top="54" width="295" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold;">Assuming a rise time of 5% of the frequency</p>
        </content>
      </text>
    </region>
    <region left="0" top="81" width="142" height="47" color="#000000" fontSize="10">
